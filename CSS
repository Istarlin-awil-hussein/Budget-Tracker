body {
    font-family: Arial, sans-serif;
    margin: 20px;
    background-color: #f4f6f8;
}

header {
    text-align: center;
    background-color: #2c7be5;
    color: white;
    padding: 20px;
}

header img {
    display: block;
    margin: 0 auto 10px;
}

.add-expense-section,
.expenses-section,
.how-to-use,
.video-section {
    background-color: white;
    padding: 20px;
    margin: 20px 0;
    border-radius: 8px;
}

form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Advanced selector: direct child */
.add-expense-section > h2 {
    margin-top: 0;
}

/* Advanced selector: negation pseudo-class */
input:not([type="submit"]) {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Advanced selector: focus state */
input:focus {
    border-color: #2c7be5;
    outline: none;
}

/* Select styling */
select {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Button */
button {
    padding: 10px;
    background-color: #2c7be5;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

/* Table */
table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    border: 1px solid #ccc;
    padding: 12px;
    text-align: left;
}

/* Colored header */
th {
    background-color: #2c7be5;
    color: white;
}

/* Advanced selector: alternating rows */
tr:nth-child(even) {
    background-color: #f2f2f2;
}

/* Advanced selector: table descendant */
.expenses-section td {
    font-size: 15px;
}

/* Table hover effect */
tr:hover {
    background-color: #dbeafe;
}

summary {
    cursor: pointer;
    font-weight: bold;
}

iframe {
    max-width: 100%;
}
